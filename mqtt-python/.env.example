# Example configuration for mqtt-mcp. Copy to mqtt-python/.env (or to any file you
# pass with --env-file) and adjust. Variables already set in the environment win.
#
# Which .env is read:
# - Without options, only mqtt-python/.env of a source checkout (this directory),
#   found next to the package source. A .env in the working directory or any parent
#   is never read: when an MCP client launches the server, that is the client's
#   project, which you may not control. An installed package has no automatic .env.
#   Even this file may set only MQTT_* and SPARKPLUG_* variables, and NOT
#   MQTT_WRITES_ENABLED (in any letter case, with or without "export "); anything
#   else (PATH, PYTHONPATH, LD_PRELOAD, ...) is ignored with a warning on stderr.
# - With `mqtt-mcp --env-file PATH`, every variable in PATH counts, including
#   MQTT_WRITES_ENABLED.

# Broker: mqtt://host[:port] (plain TCP) or mqtts://host[:port] (TLS, default port 8883)
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
# MQTT_CLIENT_ID=line-3-agent      # default: mqtt-mcp-<random hex>; never reuse a live client's ID
# MQTT_USERNAME=agent
# MQTT_PASSWORD=change-me
# MQTT_KEEPALIVE=60

# TLS (mqtts:// only)
# MQTT_TLS_CA_FILE=/path/to/ca.pem
# MQTT_TLS_CERT_FILE=/path/to/client.pem
# MQTT_TLS_KEY_FILE=/path/to/client.key
# MQTT_TLS_KEY_PASSWORD=
# MQTT_TLS_INSECURE=false         # true disables certificate checks: test benches only

# Tool behaviour
# MQTT_TOOL_TIMEOUT=5
# MQTT_MESSAGE_BUFFER_SIZE=1000

# Sparkplug B identity of this server (and default target of NCMD/DCMD)
SPARKPLUG_GROUP_ID=factory
SPARKPLUG_EDGE_NODE_ID=mcp-server

# Safety gate: read-only unless true. Honoured only from the real environment or
# an explicit --env-file, never from the automatic mqtt-python/.env.
# MQTT_WRITES_ENABLED=false
